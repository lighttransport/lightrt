            interpolation = "faceVarying"
        )
        uniform token subdivisionScheme = "none"
        rel material:binding = </World/_materials/SSSMat>
    }

    def Scope "_materials"
    {
        def Material "SSSMat" (
            prepend apiSchemas = ["MaterialXConfigAPI"]
        )
        {
            string config:mtlx:version = "1.39"
            token outputs:mtlx:surface.connect = </World/_materials/SSSMat/OpenPBRShader.outputs:surface>
            token outputs:surface.connect = </World/_materials/SSSMat/FallbackShader.outputs:surface>

            def Shader "FallbackShader"
            {
                uniform token info:id = "UsdPreviewSurface"
                color3f inputs:diffuseColor = (0.8, 0.35, 0.2)
                float inputs:roughness = 0.5
                float inputs:subsurface = 0.9
                color3f inputs:subsurfaceColor = (0.8, 0.2, 0.05)
                token outputs:surface
            }

            def Shader "OpenPBRShader"
            {
                uniform token info:id = "ND_open_pbr_surface_surfaceshader"

                # Base: warm peach/skin tone
                float inputs:base_weight = 1
                color3f inputs:base_color = (0.85, 0.50, 0.35)
                float inputs:base_metalness = 0
                float inputs:base_diffuse_roughness = 0

                # Specular: slight gloss
                float inputs:specular_weight = 1
                color3f inputs:specular_color = (1, 1, 1)
                float inputs:specular_roughness = 0.35
                float inputs:specular_ior = 1.4

                # Subsurface — primary demo parameter set
                # subsurface_weight=0.8 blends 80% SSS / 20% diffuse BRDF
                # subsurface_color: red-orange scattering (skin-like)
                # subsurface_radius=0.5  world-units mean free path
                # subsurface_radius_scale: R>G>B so red penetrates deepest
                float inputs:subsurface_weight = 0.8
                color3f inputs:subsurface_color = (0.85, 0.25, 0.08)
                float inputs:subsurface_radius = 0.5
                color3f inputs:subsurface_radius_scale = (1.0, 0.35, 0.15)
                float inputs:subsurface_scale = 1.0
                float inputs:subsurface_anisotropy = 0.3

                # Everything else off
                float inputs:coat_weight = 0
                float inputs:sheen_weight = 0
                float inputs:fuzz_weight = 0
                float inputs:thin_film_weight = 0
                float inputs:transmission_weight = 0
                float inputs:emission_luminance = 0
                color3f inputs:emission_color = (1, 1, 1)
                float inputs:geometry_opacity = 1

                token outputs:surface
            }
        }
    }

    # ── Lights ────────────────────────────────────────────────────────────────

    # Key light: front-left, warm white (reveals surface + BRDF lobe)
    def SphereLight "KeyLight"
    {
        color3f inputs:color = (1.0, 0.92, 0.80)
        float inputs:intensity = 40
        float inputs:radius = 0.5
        float3 xformOp:translate = (-2.5, 2.0, 3.0)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    # Back light: placed behind the sphere to drive SSS glow
    # The random walk exits the far side and picks up this illumination.
    def SphereLight "BackLight"
    {
        color3f inputs:color = (0.6, 0.85, 1.0)
        float inputs:intensity = 80
        float inputs:radius = 0.3
        float3 xformOp:translate = (0.0, 0.5, -3.5)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    # ── Camera ────────────────────────────────────────────────────────────────
    def Xform "CameraRig"
    {
        float3 xformOp:translate = (0, 0.3, 4.5)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Camera "Camera"
        {
            float2 clippingRange = (0.01, 100)
            float focalLength = 35
            float horizontalAperture = 36
            float verticalAperture = 24
            token projection = "perspective"
        }
    }
}

