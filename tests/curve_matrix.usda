#usda 1.0
(
    defaultPrim = "CurveMatrix"
    upAxis = "Y"
)

def Xform "CurveMatrix"
{
    def BasisCurves "LinearUniform"
    {
        uniform token type = "linear"
        uniform token wrap = "nonperiodic"
        int[] curveVertexCounts = [3, 3]
        point3f[] points = [
            (-3, -1.5, 0), (-2, -0.5, 0), (-1, -1.5, 0),
            (1, -1.5, 0), (2, -0.5, 0), (3, -1.5, 0)
        ]
        float[] widths = [0.08, 0.3] (
            interpolation = "uniform"
        )
        color3f[] primvars:displayColor = [(1, 0.1, 0.05), (0.05, 0.2, 1)] (
            interpolation = "uniform"
        )
    }

    def BasisCurves "Bezier"
    {
        uniform token type = "cubic"
        uniform token basis = "bezier"
        uniform token wrap = "nonperiodic"
        int[] curveVertexCounts = [7]
        point3f[] points = [
            (-3, 0, 0), (-2.5, 2, 0), (-1.5, 2, 0), (-1, 0, 0),
            (-0.5, -2, 0), (0.5, -2, 0), (1, 0, 0)
        ]
        float[] widths = [0.12]
        color3f[] primvars:displayColor = [(1, 0.7, 0.02)] (
            interpolation = "constant"
        )
    }

    def BasisCurves "PinnedBSpline"
    {
        uniform token type = "cubic"
        uniform token basis = "bspline"
        uniform token wrap = "pinned"
        int[] curveVertexCounts = [4]
        point3f[] points = [(-3, 1.5, 1), (-1, 3, 1), (1, 0.5, 1), (3, 1.5, 1)]
        float[] widths = [0.1, 0.16, 0.22, 0.28]
        color3f[] primvars:displayColor = [
            (0.1, 1, 0.2), (0.1, 0.8, 0.6), (0.4, 0.3, 1), (1, 0.1, 0.8)
        ] (
            interpolation = "vertex"
        )
    }

    def BasisCurves "PeriodicCatmullRom"
    {
        uniform token type = "cubic"
        uniform token basis = "catmullRom"
        uniform token wrap = "periodic"
        int[] curveVertexCounts = [5]
        point3f[] points = [(1, 0, 2), (2.5, 0.5, 2), (3, 2, 2), (1.5, 3, 2), (0.5, 1.5, 2)]
        float[] widths = [0.14]
        color3f[] primvars:displayColor = [(0.9, 0.1, 1)] (
            interpolation = "constant"
        )
    }
}
