#usda 1.0
(
    defaultPrim = "AnimatedCurves"
    startTimeCode = 1
    endTimeCode = 2
    upAxis = "Y"
)

def Xform "AnimatedCurves"
{
    def Camera "Camera"
    {
        float focalLength = 50
        float horizontalAperture = 20.955
        float verticalAperture = 15.2908
        float shutter:open = 0.25
        float shutter:close = 1
        double3 xformOp:translate = (0, 0, 10)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def BasisCurves "Bezier"
    {
        uniform token type = "cubic"
        uniform token basis = "bezier"
        uniform token wrap = "nonperiodic"
        int[] curveVertexCounts = [4]
        point3f[] points.timeSamples = {
            1: [(-2, -1, 0), (-1, 1, 0), (1, 1, 0), (2, -1, 0)],
            2: [(-2, 1, 0), (-1, -1, 0), (1, -1, 0), (2, 1, 0)]
        }
        float[] widths.timeSamples = {
            1: [0.12],
            2: [0.28]
        }
        color3f[] primvars:displayColor.timeSamples = {
            1: [(1, 0.05, 0.02)],
            2: [(0.02, 0.2, 1)]
        } (
            interpolation = "constant"
        )
    }

    def HermiteCurves "Hermite"
    {
        int[] curveVertexCounts = [2]
        point3f[] points.timeSamples = {
            1: [(-2, -1.5, 1), (2, -1.5, 1)],
            2: [(-2, 1.5, 1), (2, 1.5, 1)]
        }
        vector3f[] tangents.timeSamples = {
            1: [(3, 4, 0), (3, -4, 0)],
            2: [(3, -4, 0), (3, 4, 0)]
        }
        float[] widths = [0.16]
        color3f[] primvars:displayColor = [(0.1, 1, 0.15)] (
            interpolation = "constant"
        )
    }

    def NurbsCurves "RationalNurbs"
    {
        int[] curveVertexCounts = [4]
        int[] order = [4]
        double[] knots = [0, 0, 0, 0, 1, 1, 1, 1]
        double2[] ranges = [(0, 1)]
        point3f[] points = [(-2, -0.6, 2), (-1, 2.0, 2), (1, 2.0, 2), (2, -0.6, 2)]
        double[] pointWeights.timeSamples = {
            1: [1, 0.25, 0.25, 1],
            2: [1, 3, 3, 1]
        }
        float[] widths.timeSamples = {
            1: [0.1],
            2: [0.24]
        }
        color3f[] primvars:displayColor = [(0.2, 0.45, 1)] (
            interpolation = "constant"
        )
    }
}
